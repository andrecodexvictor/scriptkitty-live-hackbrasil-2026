{
  "name": "@script-kitty/contracts",
  "version": "0.1.0",
  "description": "ScriptKitty 2.0 Core Evidence Data Contracts, Hash Chaining & Merkle Verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "default": "./dist/common.js"
    },
    "./finding": {
      "types": "./dist/finding.d.ts",
      "import": "./dist/finding.js",
      "default": "./dist/finding.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js",
      "default": "./dist/evidence.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "import": "./dist/patch.js",
      "default": "./dist/patch.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js",
      "default": "./dist/gate.js"
    },
    "./custody": {
      "types": "./dist/custody.d.ts",
      "import": "./dist/custody.js",
      "default": "./dist/custody.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/**/*.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "security",
    "contracts",
    "evidence",
    "custody",
    "merkle",
    "zero-trust",
    "appsec",
    "agentsec"
  ],
  "author": "Script Kitty Team",
  "license": "MIT"
}
